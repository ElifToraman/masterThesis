{
  "schema_version": 1,
  "candidate_clusters": [
    "vm1-cluster",
    "vm2-cluster"
  ],
  "monitoring": {
    "query_timeout_seconds": 10,
    "snapshot_maximum_age_seconds": 120
  },
  "benchmarking": {
    "warmup_requests": 5,
    "measured_requests": 30,
    "request_timeout_seconds": 10,
    "inter_request_delay_ms": 500,
    "namespace": "benchmark",
    "service_name": "hello-benchmark",
    "metrics_pre_wait_seconds": 20,
    "metrics_post_wait_seconds": 20,
    "prometheus_step_seconds": 5,
    "cleanup_after_run": true
  },
  "feasibility": {
    "minimum_available_cpu_millicores": 200,
    "minimum_available_memory_mb": 128,
    "minimum_ready_workers": 1,
    "require_knative_ready": true,
    "require_prometheus_ready": true,
    "require_image_available": true
  },
  "deployment": {
    "timeout_seconds": 300,
    "poll_interval_seconds": 2
  },
  "results": {
    "directory": "controller/results",
    "write_json": true,
    "write_csv": true
  },
  "policy": {
    "fallback_mode": "best-effort",
    "minimum_benchmark_success_rate_percent": 100,
    "tie_breakers": [
      "objective_metric",
      "average_cpu_millicores",
      "average_memory_mb",
      "candidate_order"
    ]
  }
}
