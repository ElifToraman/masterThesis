{
  "schema_version": 1,
  "name": "hello-instrumented",
  "service_name": "hello-instrumented",
  "namespace": "default",
  "image": "host.docker.internal:5000/elif/hello-instrumented:v1",
  "endpoint": "/",
  "method": "GET",
  "workload": {
    "parameter": "work_ms",
    "value": 100,
    "maximum_value": 5000
  },
  "container": {
    "port": 8080,
    "container_concurrency": 10,
    "timeout_seconds": 60,
    "resources": {
      "requests": {
        "cpu_millicores": 50,
        "memory_mb": 64
      },
      "limits": {
        "cpu_millicores": 500,
        "memory_mb": 256
      }
    }
  },
  "autoscaling": {
    "minimum_scale": 1,
    "maximum_scale": 3
  },
  "scheduling": {
    "node_selector": {
      "workload": "serverless"
    }
  }
}
